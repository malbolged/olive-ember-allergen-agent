# --- Sanity project (filled after `npx sanity login` + project creation) ---
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Project token with Editor role - used ONLY by the seed script (never shipped to the app)
SANITY_WRITE_TOKEN=

# --- Sanity Context (created in Dashboard > Context) ---
# Organization API token with "Context Viewer" permission (Manage > org > API > Tokens)
SANITY_ORGANIZATION_TOKEN=
SANITY_ORGANIZATION_ID=
# GROQ-mode endpoint: dataset source = <projectId>.production (the menu graph)
SANITY_CONTEXT_MENU_MCP_URL=
# Knowledge-Base-mode endpoint: only Knowledge Base sources (kitchen guidance)
SANITY_CONTEXT_KB_MCP_URL=

# --- LLM (any one key; provider auto-detected, or force with LLM_PROVIDER) ---
# LLM_PROVIDER=anthropic|google|groq|openai
# LLM_MODEL=            # optional override of the provider default
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
